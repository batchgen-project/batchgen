{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efficientmoe.local/batchgen/release_input.schema.json",
  "title": "BatchGen formal release input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_commit",
    "release_version",
    "release_tag",
    "package_scope",
    "build_arch"
  ],
  "properties": {
    "base_commit": {
      "type": "string",
      "minLength": 7,
      "description": "Commit SHA/ref to release; must be reachable from origin/main."
    },
    "release_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-]?(a|b|rc|post|dev)[0-9]+)?$"
    },
    "release_tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+([.-]?(a|b|rc|post|dev)[0-9]+)?$"
    },
    "package_scope": {
      "type": "string",
      "enum": [
        "auto",
        "batchgen-only",
        "kernels-only",
        "batchgen-and-kernels",
        "full-dependency-wheels"
      ]
    },
    "build_arch": {
      "type": "string",
      "enum": [
        "sm90a",
        "sm100",
        "all"
      ]
    },
    "kernel_release_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Independent batchgen_kernels semver, without BUILD_ARCH local suffix. Required when package_scope includes kernels."
    },
    "previous_release_tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+([.-]?(a|b|rc|post|dev)[0-9]+)?$"
    }
  }
}
